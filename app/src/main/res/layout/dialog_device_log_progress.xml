<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/device_log_progress_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.3"
        android:text="正在请求手环准备完整 log 目录…"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/device_log_progress"
        style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="24dp"
        android:indeterminate="true"
        android:max="100"
        android:progress="0"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp"
        app:waveAmplitude="@dimen/device_log_progress_wave_amplitude"
        app:waveSpeed="@dimen/device_log_progress_wave_speed"
        app:wavelengthDeterminate="@dimen/device_log_progress_wavelength_determinate"
        app:wavelengthIndeterminate="36dp" />
</LinearLayout>
